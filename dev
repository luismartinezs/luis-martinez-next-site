#!/usr/bin/env bash
# Local preview on this app's registered port (doctrine ports.md, block 8940): http://localhost:8942.
# Recompile TypeScript with `node_modules/.bin/tsc -p tsconfig.json --watch` in another shell when editing src/.
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -x node_modules/.bin/tsc ]]; then
  npm ci --no-audit --no-fund
fi
node_modules/.bin/tsc -p tsconfig.json
exec zola serve --interface 127.0.0.1 --port 8942 --base-url localhost
