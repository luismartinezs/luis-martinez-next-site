#!/usr/bin/env bash
# Local preview on the port reserved for this app (http://localhost:8932).
# Recompile TypeScript with `node_modules/.bin/tsc -p tsconfig.json --watch` in another shell when editing src/.
set -euo pipefail
cd "$(dirname "$0")"

if [[ ! -x node_modules/.bin/tsc ]]; then
  npm ci --no-audit --no-fund
fi
node_modules/.bin/tsc -p tsconfig.json
exec zola serve --interface 127.0.0.1 --port 8932 --base-url localhost
